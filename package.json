{
    "name": "@paolofernetti/fsfind",
    "version": "2.0.1",
    "description": "Cross-platform file system finder: locate a file or directory anywhere on the machine",
    "license": "MIT",
    "author": {
        "name": "Paolo Fernetti",
        "email": "paolofernetti@yandex.ru",
        "url": "https://github.com/PaoloFernetti"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/PaoloFernetti/fsfind.git"
    },
    "keywords": [
        "fs",
        "filesystem",
        "file",
        "folder",
        "directory",
        "find",
        "search",
        "locate",
        "cross-platform"
    ],
    "main": "dist/cjs/index.js",
    "module": "dist/es/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/es/index.mjs",
            "require": "./dist/cjs/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "MIGRATION.md",
        "PERFORMANCE.md",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=18"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "build": "npm run clean && rollup -c build/rollup.config.mjs && npm run types",
        "types": "tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src",
        "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.cjs\" \"benchmarks/**/*.mjs\" \"build/**/*.mjs\" \"*.json\" \".github/**/*.yml\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.cjs\" \"benchmarks/**/*.mjs\" \"build/**/*.mjs\" \"*.json\" \".github/**/*.yml\"",
        "test": "npm run build && node --test tests/finder.test.cjs",
        "bench": "npm run build && node benchmarks/run.mjs",
        "release": "semantic-release"
    },
    "release": {
        "branches": [
            "master"
        ],
        "ci": true,
        "repositoryUrl": "https://github.com/PaoloFernetti/fsfind.git",
        "plugins": [
            "@semantic-release/commit-analyzer",
            "@semantic-release/release-notes-generator",
            [
                "@semantic-release/changelog",
                {
                    "changelogFile": "CHANGELOG.md"
                }
            ],
            "@semantic-release/npm",
            "@semantic-release/github",
            [
                "@semantic-release/git",
                {
                    "assets": [
                        "CHANGELOG.md",
                        "package.json"
                    ]
                }
            ]
        ]
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@rollup/plugin-typescript": "^11.1.6",
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/commit-analyzer": "^12.0.0",
        "@semantic-release/git": "^10.0.1",
        "@semantic-release/github": "^10.0.3",
        "@semantic-release/npm": "^12.0.1",
        "@semantic-release/release-notes-generator": "^13.0.0",
        "@types/node": "^20.14.8",
        "eslint": "^10.15.0",
        "prettier": "^3.10.1",
        "rollup": "^4.18.0",
        "semantic-release": "^24.0.0",
        "tslib": "^2.6.2",
        "typescript": "^5.4.5",
        "typescript-eslint": "^8.73.0"
    }
}
